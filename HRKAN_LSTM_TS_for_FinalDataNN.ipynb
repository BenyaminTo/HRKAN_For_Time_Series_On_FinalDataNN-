    "K_S        = 3   # k: Spline order \n",
    "G_S        = 3   # g: Grid size \n",
    "IMIN       = 0.0 \n",
    "IMAX       = 1.0 \n",
    "Order      = 2   # order: Nonlinearization power of HR-ReLU \n",
    "Batch_Size  = 32\n",
    "Context_Len = 120\n",
    "Pred_Len    = 20\n",
    "H_Dims      = 32\n",
    "N_Epochs    = 3000\n",
    "Learning_Rate = 3e-4\n",
    "Seq_Step = 5\n",
    "Num_Layers  = 2\n",
    "Bidirectional = False"
